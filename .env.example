# Database & Redis
DB_NAME=cloud
DB_USERNAME=cloud
DB_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3306
REDIS_PORT=6379

# Application ports
API_PORT=8000
WEB_PORT=8080

# Exact frontend origins; preserve both native App origins if adding your web domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,https://localhost

# Generate independently: 32 random bytes encoded with Base64. Do not reuse across deployments.
JWT_SECRET=
VERIFICATION_HMAC_SECRET=
CLOUD_STORAGE_SECRET_KEY=

# Local file storage directories (when running outside Docker)
CLOUD_STORAGE_ROOT=data/objects
CLOUD_UPLOAD_TEMP=data/uploads
CLOUD_PREVIEW_ROOT=data/previews
CLOUD_WORKER_TMP=data/worker-tmp

# Optional preview & search services (enabled via Docker Compose profiles: office / search)
CLOUD_PREVIEW_GOTENBERG_URL=http://127.0.0.1:3002
CLOUD_SEARCH_MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=cloudlane-dev-master-key
CLOUD_SEARCH_TIKA_URL=http://127.0.0.1:9998

# SMTP
SMTP_HOST=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
