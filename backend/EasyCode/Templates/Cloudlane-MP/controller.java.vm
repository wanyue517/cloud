$!{cloudlane.vm}
$!callback.setFileName($tool.append($entity, "Controller.java"))
$!callback.setSavePath($tool.append($basePath, "/controller"))
package $!{rootPackage}.$!{domain}.controller;

import com.wanyue.cloud.common.result.PageResult;
import com.wanyue.cloud.common.result.R;
import $!{rootPackage}.$!{domain}.service.$!{entity}Service;
import $!{rootPackage}.$!{domain}.vo.$!{entity}CreateReqVO;
import $!{rootPackage}.$!{domain}.vo.$!{entity}UpdateReqVO;
import $!{rootPackage}.$!{domain}.vo.$!{entity}PageReqVO;
import $!{rootPackage}.$!{domain}.vo.$!{entity}RespVO;
import jakarta.annotation.Resource;
import jakarta.validation.Valid;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;

/**
 * $!{tableInfo.comment}单表基础 CRUD。
 * 注意：认证表与用户主表属于敏感业务，通用 CRUD 一律禁止外部直接调用。
 * 其他业务的通用 CRUD 也必须由管理员权限保护。
 */
@Validated
@RestController
#if($domain == "auth" || $rawTable == "sys_user")
@PreAuthorize("denyAll()")
#else
@PreAuthorize("hasAuthority('system:generated:crud')")
#end
@RequestMapping("/api/admin/$!{domain}/$!{entityTable.replace("_", "-")}")
public class $!{entity}Controller {

    @Resource
    private $!{serviceClass} $!{serviceVar};

    @PostMapping
    public R<Long> create(@Valid @RequestBody $!{entity}CreateReqVO request) {
        return R.ok($!{serviceVar}.create(request));
    }

    @PutMapping("/{id}")
    public R<Void> update(@PathVariable Long id,
                          @Valid @RequestBody $!{entity}UpdateReqVO request) {
        $!{serviceVar}.update(id, request);
        return R.ok();
    }

    @DeleteMapping("/{id}")
    public R<Void> delete(@PathVariable Long id) {
        $!{serviceVar}.delete(id);
        return R.ok();
    }

    @GetMapping("/{id}")
    public R<$!{entity}RespVO> get(@PathVariable Long id) {
        return R.ok($!{serviceVar}.get(id));
    }

    @GetMapping("/page")
    public R<PageResult<$!{entity}RespVO>> page(@Valid $!{entity}PageReqVO request) {
        return R.ok($!{serviceVar}.page(request));
    }
}
