$!{cloudlane.vm}
$!callback.setFileName($tool.append($entity, "DO.java"))
$!callback.setSavePath($tool.append($basePath, "/dataobject"))
package $!{rootPackage}.$!{domain}.dataobject;

import com.baomidou.mybatisplus.annotation.TableField;
import com.baomidou.mybatisplus.annotation.TableName;
import com.wanyue.cloud.common.domain.BaseDO;
import lombok.Getter;
import lombok.Setter;
#foreach($import in $importList)
import $!{import};
#end

/**
 * $!{tableInfo.comment}（$!{rawTable}）持久化对象。
 * 公共字段由 BaseDO 定义，不重复生成。
 */
@Getter
@Setter
@TableName("$!{rawTable}")
public class $!{entity}DO extends BaseDO {
#foreach($column in $tableInfo.fullColumn)
#if(!$baseFields.contains($column.obj.name))
    /** $!{column.comment} */
    @TableField("$!{column.obj.name}")
    private $!{column.shortType} $!{column.name};
#end
#end
}
