{
  "name": "frontend",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@cloud/web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:web": "turbo run check-types --filter=@cloud/web",
    "dev:admin": "turbo run dev --filter=@cloud/admin",
    "check:admin": "turbo run check-types --filter=@cloud/admin",
    "dev:mobile": "turbo run dev --filter=@cloud/mobile",
    "check:mobile": "turbo run check-types --filter=@cloud/mobile",
    "build:web": "turbo run build --filter=@cloud/web",
    "build:admin": "turbo run build --filter=@cloud/admin",
    "build:mobile": "turbo run build --filter=@cloud/mobile",
    "dev": "turbo run dev --filter=@cloud/web --filter=@cloud/admin --filter=@cloud/mobile",
    "test": "pnpm --filter @cloud/web test && pnpm --filter @cloud/mobile test && pnpm --filter @repo/drive-core test",
    "test:mobile": "pnpm --filter @cloud/mobile test",
    "test:core": "pnpm --filter @repo/drive-core test",
    "api:generate": "node packages/api-client/scripts/generate-types.mjs",
    "api:check": "node packages/api-client/scripts/generate-types.mjs --check"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
